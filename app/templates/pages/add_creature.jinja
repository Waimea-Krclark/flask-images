{#=====================================================
  Welcome page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2 class="welcome">Add creature</h2>

    <form method="post" action="/add" enctype="multipart/form-data">
    <label>
        Name
        <input name="name" type="text" required>
    </label>

    <label>
        Species
        <input name="species" type="text" required>
    </label>

    <label>
        Image
        <input
            name="image"
            type="file"
            accept="image/png, image/jpeg, image/gif"
            required
        >
    </label>

    <button>Add Creature</button>
</form>

{% endblock %}

